{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "creative.json, section innovate_spells (Level 2a)",
  "type": "object",
  "required": [
    "innovate_spells"
  ],
  "properties": {
    "innovate_spells": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum",
        "slots"
      ],
      "properties": {
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "slots": {
          "description": "One key per slot, in order: the slot number fixes the game rows. A filled slot's key is the spell id; an empty slot is null (any key). The number of slots must equal maximum (checked by the tool, not by this schema).",
          "type": "object",
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]{0,39}$": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/spell"
                }
              ]
            }
          },
          "additionalProperties": {
            "type": "null"
          }
        }
      }
    },
    "scripts": {
      "type": "object",
      "description": "scripts.added: the scripts added after the build (`scripts add | remove | change`)",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resurrect": {
      "type": "object",
      "properties": {
        "great_enemies": {
          "type": "object",
          "description": "activate: the great enemies `run` brings back once a character is in the world: \"all\" / \"*\", or names and ids",
          "properties": {
            "activate": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "integer"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "spell": {
      "anyOf": [
        {
          "$ref": "#/$defs/buff"
        },
        {
          "$ref": "#/$defs/template"
        },
        {
          "$ref": "#/$defs/design"
        }
      ]
    },
    "buff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requires",
        "fp_cost"
      ],
      "properties": {
        "type": {
          "const": "incantation"
        },
        "text": {
          "type": "object",
          "description": "The spell's text in the game (not part of the build; `write --text` puts it into the running game). goods_name: the name; goods_info: the short line under it; goods_captions: the long description (Inventory, square button). Empty or left out: the game shows nothing.",
          "additionalProperties": false,
          "properties": {
            "goods_name": {
              "type": "string",
              "maxLength": 80
            },
            "goods_info": {
              "type": "string",
              "maxLength": 300
            },
            "goods_captions": {
              "type": "string",
              "maxLength": 3000
            }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intelligence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "faith": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "arcane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "fp_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "stamina_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "cast_motion": {
          "anyOf": [
            {
              "enum": [
                "flame-grant-me-strength",
                "black-flame-blade"
              ]
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            }
          ]
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heal_hp_per_tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "restore_fp_per_tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            "stamina_regen_speed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "tick_seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 60
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 600
            },
            "visual": {
              "anyOf": [
                {
                  "enum": [
                    "flame",
                    "flask",
                    "none",
                    null
                  ]
                },
                {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 99999999
                }
              ]
            }
          }
        },
        "poise_while_casting_seconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        },
        "flame_color": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
              "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          ],
          "description": "\"#RRGGBB\" (or [red, green, blue]) of the fire of Flame, Grant Me Strength (the fire while casting and the burst), put into the running game by write --flame-color; 1 = full colour, above 1 shines brighter"
        },
        "flame_accent_color": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
              "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          ],
          "description": "\"#RRGGBB\" (or [red, green, blue]) of the parts of the fire flame_color leaves out (pink and red in the game's file), put into the running game by write --flame-color; goes with flame_color"
        },
        "positive_curse_energy_eyes": {
          "description": "while the buff lasts both of the caster's eyes glow (SpEffectVfx 20090050 and 20090051, effect 4866, added to the buff's SpEffect row)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
                  "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
                },
                {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              ],
              "description": "\"#RRGGBB\" (or [red, green, blue]) of the glow, put into the running game by write --flame-color; without it the eyes are the game's red"
            }
          }
        },
        "shop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price"
          ],
          "properties": {
            "price": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999999
            },
            "stock": {
              "type": "integer",
              "minimum": -1,
              "maximum": 99,
              "not": {
                "const": 0
              }
            }
          }
        },
        "kind": {
          "const": "buff"
        }
      },
      "description": "kind buff (the default when `kind` is left out): a heal-over-time buff built from Flame, Grant Me Strength.",
      "dependentRequired": {
        "flame_accent_color": [
          "flame_color"
        ]
      }
    },
    "template": {
      "description": "A spell made from a game spell: kind clone (a copy of its Goods and Magic rows; it keeps the template's chain), enchant (a weapon or shield enchant; its SpEffect rows are copied too), projectile (the same for a spell that throws Bullets: its Bullet and AtkParam_Pc rows are copied too), attack (a spell that makes a direct attack: its AtkParam_Pc rows are copied too) or buff with `from` (the same for a buff). What is left out stays the template's. Checked by the tool, not by this schema: `from` must be a player spell with a Goods row of the right kind, `type` must equal the template's, a Magic or Goods `set` key's row id must equal `from`, a SpEffect, Bullet or AtkParam_Pc key must name one of the copied rows (a clone has none; Bullet is for projectile only, AtkParam_Pc for projectile and attack), the field must exist and the value fit it, and id fields and fields that have a friendly name are refused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from"
      ],
      "properties": {
        "kind": {
          "enum": [
            "clone",
            "enchant",
            "projectile",
            "attack",
            "buff"
          ]
        },
        "from": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "type": {
          "enum": [
            "incantation",
            "sorcery"
          ]
        },
        "text": {
          "type": "object",
          "description": "The spell's text in the game (not part of the build; `write --text` puts it into the running game). goods_name: the name; goods_info: the short line under it; goods_captions: the long description (Inventory, square button). Empty or left out: the game shows nothing.",
          "additionalProperties": false,
          "properties": {
            "goods_name": {
              "type": "string",
              "maxLength": 80
            },
            "goods_info": {
              "type": "string",
              "maxLength": 300
            },
            "goods_captions": {
              "type": "string",
              "maxLength": 3000
            }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intelligence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "faith": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "arcane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "fp_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "stamina_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "flame_color": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
              "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          ],
          "description": "\"#RRGGBB\" (or [red, green, blue]) of the fire of Flame, Grant Me Strength (the fire while casting and the burst), put into the running game by write --flame-color; 1 = full colour, above 1 shines brighter"
        },
        "flame_accent_color": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
              "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          ],
          "description": "\"#RRGGBB\" (or [red, green, blue]) of the parts of the fire flame_color leaves out (pink and red in the game's file), put into the running game by write --flame-color; goes with flame_color"
        },
        "positive_curse_energy_eyes": {
          "description": "while the buff lasts both of the caster's eyes glow (SpEffectVfx 20090050 and 20090051, effect 4866, added to the copied SpEffect row `on`)",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on"
          ],
          "properties": {
            "on": {
              "description": "the copied SpEffect row that is the buff: SpEffect.<id>, the template's id as in `set`",
              "type": "string",
              "pattern": "^SpEffect\\.[0-9]+$"
            },
            "color": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
                  "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
                },
                {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              ],
              "description": "\"#RRGGBB\" (or [red, green, blue]) of the glow, put into the running game by write --flame-color; without it the eyes are the game's red"
            }
          }
        },
        "shop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price"
          ],
          "properties": {
            "price": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999999
            },
            "stock": {
              "type": "integer",
              "minimum": -1,
              "maximum": 99,
              "not": {
                "const": 0
              }
            }
          }
        },
        "set": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(Magic|Goods|SpEffect|Bullet|AtkParam_Pc)\\.[0-9]+\\.[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "dependentRequired": {
        "flame_accent_color": [
          "flame_color"
        ]
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "__info__": {
          "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
          "type": "string"
        },
        "kind": {
          "enum": [
            "attack",
            "buff",
            "clone",
            "enchant",
            "projectile"
          ]
        },
        "from": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "type": {
          "enum": [
            "incantation",
            "sorcery"
          ]
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "__info__": {
              "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
              "type": "string"
            },
            "status": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "__info__": {
                  "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
                  "type": "string"
                },
                "intelligence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "faith": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                },
                "arcane": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 99
                }
              }
            },
            "cost": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "__info__": {
                  "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
                  "type": "string"
                },
                "focus_point": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                },
                "stamina": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              }
            }
          },
          "description": "status: the attributes the character needs; cost: what casting takes"
        },
        "locations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "__info__": {
              "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
              "type": "string"
            }
          },
          "patternProperties": {
            "^([Kk]al[eé]|<shop-id-[0-9]+>)$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "price"
              ],
              "properties": {
                "price": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99999999
                },
                "stock": {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 99,
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          },
          "description": "where the spell is sold: this version sells at Kalé only, written \"kale\"; one place"
        },
        "customs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "__info__": {
              "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
              "type": "string"
            },
            "basic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "__info__": {
                  "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
                  "type": "string"
                }
              },
              "patternProperties": {
                "^(Magic|Goods|SpEffect|Bullet|AtkParam_Pc)\\.[0-9]+\\.[A-Za-z_][A-Za-z0-9_]*$": {
                  "type": "number"
                }
              },
              "description": "numbers written over the copies of the game's rows, <Table>.<row id>.<field> (built into regulation.bin)"
            },
            "advanced": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "__info__": {
                  "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
                  "type": "string"
                },
                "texts": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "__info__": {
                      "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
                      "type": "string"
                    },
                    "goods_name": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "goods_info": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "goods_caption": {
                      "type": "string",
                      "maxLength": 3000
                    },
                    "goods_captions": {
                      "type": "string",
                      "maxLength": 3000
                    }
                  }
                },
                "colors": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "__info__": {
                      "description": "a comment for people: what the spell or this part is and how it works; the tool does not read it",
                      "type": "string"
                    }
                  },
                  "patternProperties": {
                    "^Magic\\.[0-9]+\\.castSfxId$": {
                      "oneOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
                              "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
                            },
                            {
                              "type": "array",
                              "minItems": 3,
                              "maxItems": 3,
                              "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 2
                              }
                            }
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "main"
                          ],
                          "properties": {
                            "main": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
                                  "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
                                },
                                {
                                  "type": "array",
                                  "minItems": 3,
                                  "maxItems": 3,
                                  "items": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 2
                                  }
                                }
                              ]
                            },
                            "accent": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
                                  "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
                                },
                                {
                                  "type": "array",
                                  "minItems": 3,
                                  "maxItems": 3,
                                  "items": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 2
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    },
                    "^SpEffect\\.[0-9]+$": {
                      "oneOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^#?([0-9a-fA-F]{6}|[0-9a-fA-F]{3})$",
                              "description": "a hex colour: \"#90D5FF\" (or \"#9DF\")"
                            },
                            {
                              "type": "array",
                              "minItems": 3,
                              "maxItems": 3,
                              "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 2
                              }
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "description": "put into the running game after the world loads: the fire (and its accent, the ring of runes) of the effect the spell casts, the eyes while a buff row lasts"
                }
              },
              "description": "Level 3: texts and colours, put into the running game's memory (never built into regulation.bin)"
            }
          }
        }
      },
      "required": [
        "from"
      ],
      "description": "A spell made from a game spell, written in the structure of section 1b: requires.status/cost, locations, customs.basic/advanced. The earlier fields (fp_cost, shop, set, text, flame_color, ...) stay valid."
    }
  }
}
