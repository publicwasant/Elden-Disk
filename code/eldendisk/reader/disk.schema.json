{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EldenDiskLiveState",
  "type": "object",
  "required": ["systems", "character"],
  "properties": {
    "systems": {
      "type": "object",
      "required": ["profile", "features", "status", "session"],
      "properties": {
        "profile": {
          "type": "object",
          "required": ["sha256", "game", "version"],
          "properties": {
            "sha256": { "type": ["string", "null"] },
            "game": { "type": "string" },
            "version": { "type": ["string", "null"] }
          }
        },
        "features": {
          "type": "object",
          "required": ["buffs_supported", "animations_supported", "creative_supported"],
          "properties": {
            "buffs_supported": { "type": "boolean" },
            "animations_supported": { "type": "boolean" },
            "creative_supported": { "type": "boolean" }
          }
        },
        "status": {
          "type": "object",
          "required": ["pid", "tool_state", "anti_cheat_state", "game_connected", "ignored"],
          "properties": {
            "pid": { "type": ["integer", "null"] },
            "tool_state": { "enum": ["WAITING_FOR_PROCESS", "EAC_ACTIVE", "EAC_DETECTED", "UNSUPPORTED_VERSION", "WAITING_FOR_WORLD", "CONNECTED", "DISCONNECTED", "IDLE"] },
            "anti_cheat_state": { "enum": ["DISABLED_OFFLINE", "ACTIVE_EAC", "UNKNOWN"] },
            "game_connected": { "type": "boolean" },
            "ignored": {
              "type": "object",
              "required": ["buffs", "animations"],
              "properties": {
                "buffs": { "type": "integer", "minimum": 0 },
                "animations": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "required": ["mode", "read_only", "creative"],
          "properties": {
            "mode": { "type": "string" },
            "read_only": { "type": "boolean" },
            "creative": { "type": "boolean" }
          }
        },
        "errors": {
          "type": ["object", "null"],
          "required": ["code", "message", "details", "timestamp"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "details": { "type": ["string", "null"] },
            "timestamp": { "type": "string" }
          }
        }
      }
    },
    "character": {
      "type": ["object", "null"],
      "required": ["level", "vitals", "runes", "attributes", "buffs", "animations"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 713 },
        "lock_on": {
          "type": "boolean",
          "description": "1.8.4, when the profile has player_to_lock_on: true while the player is locked on to something (nothing about the target)"
        },
        "inventory": {
          "type": ["object", "null"],
          "description": "1.8.1, when the profile has an inventory block: what the character carries, by kind; each item by its id (the row of its table; a weapon: the row plus its level) with its name (the game's text, null when unknown), quantity (total, held: carried, stored: in the storage chest), type (goods) and upgrade (weapons). null while it cannot be read.",
          "required": ["goods", "key_items", "talismans", "weapons", "armor", "ashes_of_war"],
          "additionalProperties": false,
          "properties": {
            "goods": { "$ref": "#/$defs/items" }, "key_items": { "$ref": "#/$defs/items" }, "talismans": { "$ref": "#/$defs/items" },
            "weapons": { "$ref": "#/$defs/items" }, "armor": { "$ref": "#/$defs/items" }, "ashes_of_war": { "$ref": "#/$defs/items" }
          }
        },
        "equipment": {
          "type": "object",
          "description": "1.7.2, when the profile has an equipment block: the spells memorised in the magic slots (numbered from 1) and the selected one",
          "properties": {
            "magic": {
              "type": "object",
              "required": ["selected", "slots"],
              "properties": {
                "selected": { "type": "object", "required": ["slot", "id"],
                              "properties": { "slot": { "type": "integer", "minimum": 1 }, "id": { "type": ["integer", "null"] } } },
                "slots": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "type": "integer" } }
              }
            }
          }
        },
        "vitals": {
          "type": "object",
          "required": ["hit_point", "focus_point", "stamina"],
          "properties": {
            "hit_point": {
              "type": "object",
              "required": ["current", "maximum", "base"],
              "properties": {
                "current": { "type": "integer" },
                "maximum": { "type": "integer" },
                "base": { "type": "integer" }
              }
            },
            "focus_point": {
              "type": "object",
              "required": ["current", "maximum", "base"],
              "properties": {
                "current": { "type": "integer" },
                "maximum": { "type": "integer" },
                "base": { "type": "integer" }
              }
            },
            "stamina": {
              "type": "object",
              "required": ["current", "maximum", "base"],
              "properties": {
                "current": { "type": "integer" },
                "maximum": { "type": "integer" },
                "base": { "type": "integer" }
              }
            }
          }
        },
        "runes": {
          "type": "object",
          "required": ["total", "baseline", "delta"],
          "properties": {
            "total": { "type": "integer", "minimum": 0, "maximum": 999999999 },
            "baseline": { "type": "integer", "minimum": 0, "maximum": 999999999 },
            "delta": { "type": "integer" }
          }
        },
        "attributes": {
          "type": "object",
          "required": ["vigor", "mind", "endurance", "strength", "dexterity", "intelligence", "faith", "arcane"],
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 99 }
        },
        "buffs": {
          "type": "object",
          "description": "1.8.2: the buffs a held item gives, by their SpEffect id: the item's object of character.inventory (name, quantity, type, upgrade), reference (the inventory paths of every held item that gives it; the object is the first one's) and times (a timed buff).",
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": {
            "type": "object",
            "required": ["name", "quantity", "reference"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": ["string", "null"] },
              "type": { "type": ["string", "integer", "null"] },
              "upgrade": { "type": "integer", "minimum": 0 },
              "quantity": { "$ref": "#/$defs/items/additionalProperties/properties/quantity" },
              "reference": {
                "type": "array", "minItems": 1,
                "items": { "type": "string", "pattern": "^character\\.inventory\\.(goods|key_items|talismans|weapons|armor|ashes_of_war)\\.[0-9]+$" }
              },
              "times": {
                "type": "object",
                "required": ["buff_duration", "max_duration", "last_activated_at"],
                "properties": {
                  "buff_duration": { "type": ["number", "null"], "minimum": 0 },
                  "max_duration": { "type": ["number", "null"], "exclusiveMinimum": 0 },
                  "last_activated_at": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "animations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "categories"],
            "properties": {
              "name": { "type": "string" },
              "categories": { "type": "string" },
              "abilities": { "type": "string" }
            }
          }
        }
      }
    },
    "creative": {
      "type": ["object", "null"],
      "description": "1.8.0: what exists only in the parallel world. scripts: the scripts' host and every script (from its status file); innovate_spells.<goods id>: the spells of the last build (id, slot, rows) with their design and what the game holds now; resurrect.great_enemies.<id>: the great enemies that are defeated now (name, place, grace, runes, drop, story, dlc, defeated: true). A part without data is left out; null when there is none.",
      "properties": {
        "scripts": {
          "type": "object",
          "required": ["host", "defaults", "added"],
          "properties": {
            "host": { "type": ["object", "null"] },
            "defaults": { "type": "object" },
            "added": { "type": "object" }
          }
        },
        "innovate_spells": {
          "type": "object",
          "propertyNames": { "pattern": "^[1-9][0-9]*$" },
          "additionalProperties": { "type": "object", "required": ["id", "slot", "rows", "design"] }
        },
        "resurrect": {
          "type": "object",
          "properties": {
            "great_enemies": {
              "type": "object",
              "propertyNames": { "pattern": "^[1-9][0-9]*$" },
              "additionalProperties": { "type": "object", "required": ["name", "defeated"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "items": {
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "quantity"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"] },
          "quantity": {
            "type": "object",
            "required": ["total", "held", "stored"],
            "additionalProperties": false,
            "properties": {
              "total": { "type": ["integer", "null"], "minimum": 1 },
              "held": { "type": "integer", "minimum": 0 },
              "stored": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "type": { "type": ["string", "integer", "null"] },
          "upgrade": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
