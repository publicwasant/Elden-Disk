{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EldenDiskLiveState",
  "type": "object",
  "required": ["systems", "character"],
  "properties": {
    "systems": {
      "type": "object",
      "required": ["profile", "features", "status", "session"],
      "properties": {
        "profile": {
          "type": "object",
          "required": ["sha256", "game", "version"],
          "properties": {
            "sha256": { "type": ["string", "null"] },
            "game": { "type": "string" },
            "version": { "type": ["string", "null"] }
          }
        },
        "features": {
          "type": "object",
          "required": ["buffs_supported", "animations_supported", "sandbox_supported"],
          "properties": {
            "buffs_supported": { "type": "boolean" },
            "animations_supported": { "type": "boolean" },
            "sandbox_supported": { "type": "boolean" }
          }
        },
        "status": {
          "type": "object",
          "required": ["pid", "tool_state", "anti_cheat_state", "game_connected", "ignored"],
          "properties": {
            "pid": { "type": ["integer", "null"] },
            "tool_state": { "enum": ["WAITING_FOR_PROCESS", "EAC_ACTIVE", "EAC_DETECTED", "UNSUPPORTED_VERSION", "WAITING_FOR_WORLD", "CONNECTED", "DISCONNECTED", "IDLE"] },
            "anti_cheat_state": { "enum": ["DISABLED_OFFLINE", "ACTIVE_EAC", "UNKNOWN"] },
            "game_connected": { "type": "boolean" },
            "ignored": {
              "type": "object",
              "required": ["buffs", "animations"],
              "properties": {
                "buffs": { "type": "integer", "minimum": 0 },
                "animations": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "required": ["mode", "read_only", "sandbox"],
          "properties": {
            "mode": { "type": "string" },
            "read_only": { "type": "boolean" },
            "sandbox": { "type": "boolean" }
          }
        },
        "errors": {
          "type": ["object", "null"],
          "required": ["code", "message", "details", "timestamp"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "details": { "type": ["string", "null"] },
            "timestamp": { "type": "string" }
          }
        }
      }
    },
    "character": {
      "type": ["object", "null"],
      "required": ["level", "vitals", "runes", "attributes", "buffs", "animations"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 713 },
        "equipment": {
          "type": "object",
          "description": "1.7.2, when the profile has an equipment block: the spells memorised in the magic slots (numbered from 1) and the selected one",
          "properties": {
            "magic": {
              "type": "object",
              "required": ["selected", "slots"],
              "properties": {
                "selected": { "type": "object", "required": ["slot", "id"],
                              "properties": { "slot": { "type": "integer", "minimum": 1 }, "id": { "type": ["integer", "null"] } } },
                "slots": { "type": "object", "propertyNames": { "pattern": "^[1-9][0-9]*$" }, "additionalProperties": { "type": "integer" } }
              }
            }
          }
        },
        "vitals": {
          "type": "object",
          "required": ["hit_point", "focus_point", "stamina"],
          "properties": {
            "hit_point": {
              "type": "object",
              "required": ["current", "maximum", "base"],
              "properties": {
                "current": { "type": "integer" },
                "maximum": { "type": "integer" },
                "base": { "type": "integer" }
              }
            },
            "focus_point": {
              "type": "object",
              "required": ["current", "maximum", "base"],
              "properties": {
                "current": { "type": "integer" },
                "maximum": { "type": "integer" },
                "base": { "type": "integer" }
              }
            },
            "stamina": {
              "type": "object",
              "required": ["current", "maximum", "base"],
              "properties": {
                "current": { "type": "integer" },
                "maximum": { "type": "integer" },
                "base": { "type": "integer" }
              }
            }
          }
        },
        "runes": {
          "type": "object",
          "required": ["total", "baseline", "delta"],
          "properties": {
            "total": { "type": "integer", "minimum": 0, "maximum": 999999999 },
            "baseline": { "type": "integer", "minimum": 0, "maximum": 999999999 },
            "delta": { "type": "integer" }
          }
        },
        "attributes": {
          "type": "object",
          "required": ["vigor", "mind", "endurance", "strength", "dexterity", "intelligence", "faith", "arcane"],
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 99 }
        },
        "buffs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "categories"],
            "properties": {
              "name": { "type": "string" },
              "categories": { "type": "string" },
              "abilities": { "type": "string" },
              "times": {
                "type": "object",
                "required": ["buff_duration", "max_duration", "last_activated_at"],
                "properties": {
                  "buff_duration": { "type": ["number", "null"], "minimum": 0 },
                  "max_duration": { "type": ["number", "null"], "exclusiveMinimum": 0 },
                  "last_activated_at": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "animations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "categories"],
            "properties": {
              "name": { "type": "string" },
              "categories": { "type": "string" },
              "abilities": { "type": "string" }
            }
          }
        }
      }
    },
    "params": {
      "type": ["object", "null"],
      "description": "Tables of the game itself (params.<table>.<row id>.<field>); null with no game attached.",
      "properties": {
        "effects": {
          "type": "object",
          "description": "SpEffectParam rows listed in offsets.json, by row id",
          "propertyNames": { "pattern": "^(0|[1-9][0-9]*)$" },
          "additionalProperties": {
            "type": "object",
            "required": ["name", "effectEndurance", "motionInterval", "changeHpRate", "changeHpPoint",
                         "atkOccurrenceSpEffectId", "vfxId"],
            "properties": {
              "name": { "type": "string" },
              "effectEndurance": { "type": "number" },
              "motionInterval": { "type": "number" },
              "changeHpRate": { "type": "number" },
              "changeHpPoint": { "type": "integer" },
              "atkOccurrenceSpEffectId": { "type": "integer" },
              "vfxId": { "type": "integer" }
            }
          }
        }
      }
    },
    "design": {
      "type": ["object", "null"],
      "description": "1.7.2: the design's spells of the last build (design.innovate_items.spells.<goods id>) with what the game holds now; 1.8.0: the great enemies (design.resurrect.great_enemies.<id>: name, place, grace, runes, drop, story, dlc, defeated) when the profile has an event_flags block; null when there is neither.",
      "properties": {
        "innovate_items": {
          "type": "object",
          "properties": {
            "spells": {
              "type": "object",
              "propertyNames": { "pattern": "^[1-9][0-9]*$" },
              "additionalProperties": { "type": "object", "required": ["id", "slot", "rows"] }
            }
          }
        }
      }
    }
  }
}
