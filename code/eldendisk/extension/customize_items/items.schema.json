{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "customize-items items.draft.json (format 1, Level 2a)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "format": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "requires", "fp_cost", "shop"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "type": {"const": "incantation"},
          "name": {"type": "string", "maxLength": 80},
          "description": {"type": "string", "maxLength": 400},
          "requires": {"type": "object", "additionalProperties": false, "properties": {
            "intelligence": {"type": "integer", "minimum": 0, "maximum": 99},
            "faith": {"type": "integer", "minimum": 0, "maximum": 99},
            "arcane": {"type": "integer", "minimum": 0, "maximum": 99}}},
          "fp_cost": {"type": "integer", "minimum": 0, "maximum": 999},
          "stamina_cost": {"type": "integer", "minimum": 0, "maximum": 999},
          "cast_motion": {"enum": ["flame-grant-me-strength", "black-flame-blade"]},
          "effect": {"type": "object", "additionalProperties": false, "properties": {
            "heal_hp_per_tick": {"type": "integer", "minimum": 0, "maximum": 9999},
            "restore_fp_per_tick": {"type": "integer", "minimum": 0, "maximum": 999},
            "stamina_regen_speed": {"type": "integer", "minimum": 0, "maximum": 9999},
            "tick_seconds": {"type": "number", "minimum": 0.1, "maximum": 60},
            "duration_seconds": {"type": "number", "minimum": 0.5, "maximum": 600},
            "visual": {"enum": ["flame", "flask", "none", null]}}},
          "poise_while_casting_seconds": {"type": "number", "minimum": 0.1, "maximum": 10},
          "shop": {"type": "object", "additionalProperties": false, "required": ["price"], "properties": {
            "price": {"type": "integer", "minimum": 1, "maximum": 99999999},
            "stock": {"type": "integer", "minimum": -1, "maximum": 99, "not": {"const": 0}}}}
        }
      }
    }
  }
}
