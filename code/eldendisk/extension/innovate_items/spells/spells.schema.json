{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extension.json, section innovate_items.spells (Level 2a)",
  "type": "object",
  "required": [
    "innovate_items"
  ],
  "properties": {
    "innovate_items": {
      "type": "object",
      "required": [
        "spells"
      ],
      "properties": {
        "spells": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximum",
            "slots"
          ],
          "properties": {
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "slots": {
              "description": "One key per slot, in order: the slot number fixes the game rows. A filled slot's key is the spell id; an empty slot is null (any key). The number of slots must equal maximum (checked by the tool, not by this schema).",
              "type": "object",
              "patternProperties": {
                "^[a-z0-9][a-z0-9_-]{0,39}$": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/spell"
                    }
                  ]
                }
              },
              "additionalProperties": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "spell": {
      "oneOf": [
        {
          "$ref": "#/$defs/buff"
        },
        {
          "$ref": "#/$defs/template"
        }
      ]
    },
    "buff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requires",
        "fp_cost"
      ],
      "properties": {
        "type": {
          "const": "incantation"
        },
        "text": {
          "type": "object",
          "description": "The spell's text in the game (not part of the build; `write --text` puts it into the running game). goods_name: the name; goods_info: the short line under it; goods_captions: the long description (Inventory, square button). Empty or left out: the game shows nothing.",
          "additionalProperties": false,
          "properties": {
            "goods_name": {
              "type": "string",
              "maxLength": 80
            },
            "goods_info": {
              "type": "string",
              "maxLength": 300
            },
            "goods_captions": {
              "type": "string",
              "maxLength": 3000
            }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intelligence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "faith": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "arcane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "fp_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "stamina_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "cast_motion": {
          "anyOf": [
            {
              "enum": [
                "flame-grant-me-strength",
                "black-flame-blade"
              ]
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            }
          ]
        },
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "heal_hp_per_tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "restore_fp_per_tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            "stamina_regen_speed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "tick_seconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 60
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 600
            },
            "visual": {
              "anyOf": [
                {
                  "enum": [
                    "flame",
                    "flask",
                    "none",
                    null
                  ]
                },
                {
                  "type": "integer",
                  "minimum": -1,
                  "maximum": 99999999
                }
              ]
            }
          }
        },
        "poise_while_casting_seconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        },
        "flame_color": {
          "description": "[red, green, blue] of the fire of Flame, Grant Me Strength (the fire while casting and the burst), put into the running game by write --flame-color; 1 = full colour, above 1 shines brighter",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "flame_accent_color": {
          "description": "[red, green, blue] of the parts of the fire flame_color leaves out (pink and red in the game's file), put into the running game by write --flame-color; goes with flame_color",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "golden_eyes": {
          "description": "while the buff lasts both of the caster's eyes glow (SpEffectVfx 20090050 and 20090051, effect 4866, added to the buff's SpEffect row)",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "description": "[red, green, blue] of the glow, put into the running game by write --flame-color; without it the eyes are the game's red",
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        },
        "shop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price"
          ],
          "properties": {
            "price": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999999
            },
            "stock": {
              "type": "integer",
              "minimum": -1,
              "maximum": 99,
              "not": {
                "const": 0
              }
            }
          }
        },
        "kind": {
          "const": "buff"
        }
      },
      "description": "kind buff (the default when `kind` is left out): a heal-over-time buff built from Flame, Grant Me Strength.",
      "dependentRequired": {
        "flame_accent_color": [
          "flame_color"
        ]
      }
    },
    "template": {
      "description": "A spell made from a game spell: kind clone (a copy of its Goods and Magic rows; it keeps the template's chain), enchant (a weapon or shield enchant; its SpEffect rows are copied too), projectile (the same for a spell that throws Bullets: its Bullet and AtkParam_Pc rows are copied too), attack (a spell that makes a direct attack: its AtkParam_Pc rows are copied too) or buff with `from` (the same for a buff). What is left out stays the template's. Checked by the tool, not by this schema: `from` must be a player spell with a Goods row of the right kind, `type` must equal the template's, a Magic or Goods `set` key's row id must equal `from`, a SpEffect, Bullet or AtkParam_Pc key must name one of the copied rows (a clone has none; Bullet is for projectile only, AtkParam_Pc for projectile and attack), the field must exist and the value fit it, and id fields and fields that have a friendly name are refused.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from"
      ],
      "properties": {
        "kind": {
          "enum": [
            "clone",
            "enchant",
            "projectile",
            "attack",
            "buff"
          ]
        },
        "from": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "type": {
          "enum": [
            "incantation",
            "sorcery"
          ]
        },
        "text": {
          "type": "object",
          "description": "The spell's text in the game (not part of the build; `write --text` puts it into the running game). goods_name: the name; goods_info: the short line under it; goods_captions: the long description (Inventory, square button). Empty or left out: the game shows nothing.",
          "additionalProperties": false,
          "properties": {
            "goods_name": {
              "type": "string",
              "maxLength": 80
            },
            "goods_info": {
              "type": "string",
              "maxLength": 300
            },
            "goods_captions": {
              "type": "string",
              "maxLength": 3000
            }
          }
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intelligence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "faith": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "arcane": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        },
        "fp_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "stamina_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "flame_color": {
          "description": "[red, green, blue] of the fire of Flame, Grant Me Strength (the fire while casting and the burst), put into the running game by write --flame-color; 1 = full colour, above 1 shines brighter",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "flame_accent_color": {
          "description": "[red, green, blue] of the parts of the fire flame_color leaves out (pink and red in the game's file), put into the running game by write --flame-color; goes with flame_color",
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "golden_eyes": {
          "description": "while the buff lasts both of the caster's eyes glow (SpEffectVfx 20090050 and 20090051, effect 4866, added to the copied SpEffect row `on`)",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on"
          ],
          "properties": {
            "on": {
              "description": "the copied SpEffect row that is the buff: SpEffect.<id>, the template's id as in `set`",
              "type": "string",
              "pattern": "^SpEffect\\.[0-9]+$"
            },
            "color": {
              "description": "[red, green, blue] of the glow, put into the running game by write --flame-color; without it the eyes are the game's red",
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        },
        "shop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "price"
          ],
          "properties": {
            "price": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99999999
            },
            "stock": {
              "type": "integer",
              "minimum": -1,
              "maximum": 99,
              "not": {
                "const": 0
              }
            }
          }
        },
        "set": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(Magic|Goods|SpEffect|Bullet|AtkParam_Pc)\\.[0-9]+\\.[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "dependentRequired": {
        "flame_accent_color": [
          "flame_color"
        ]
      }
    }
  }
}
